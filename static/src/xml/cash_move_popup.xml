<templates id="template" xml:space="preserve">

    <t t-inherit="point_of_sale.CashMovePopup" t-inherit-mode="extension" owl="1">
        <xpath expr="//button[contains(@t-on-click, &quot;'in'&quot;)]" position="attributes">
            <attribute name="t-if">(pos.user._role || (pos.user.raw and pos.user.raw.role)) === 'manager'</attribute>
        </xpath>
    </t>

</templates>
